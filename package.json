{
    "name": "@particle-academy/fancy-chat-js",
    "version": "0.2.0",
    "description": "The agent-chat wire contract: the thread log fancy-chat-php projects Prism Harness runs into. v1 run, turn, message and HITL events with gapless per-thread seq and resumable replay, typed message parts with a registry, the turn-state machine, delivery states, HITL records, the agent status vocabulary and a pure thread projection. Zero runtime dependencies and isomorphic, so it runs in the browser. Held to particle-academy/fancy-chat-php by shared conformance fixtures.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Particle-Academy/fancy-chat-js.git"
    },
    "homepage": "https://github.com/Particle-Academy/fancy-chat-js#readme",
    "bugs": "https://github.com/Particle-Academy/fancy-chat-js/issues",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./contract/machines.json": "./contract/machines.json",
        "./conformance/chat-v1.json": "./conformance/chat-v1.json",
        "./package.json": "./package.json"
    },
    "bin": {
        "fancy-chat-check-install": "scripts/check-install.mjs"
    },
    "files": [
        "dist",
        "contract",
        "conformance",
        "scripts/check-install.mjs",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "sabotage": "node tests/sabotage.mjs",
        "prepublishOnly": "tsup"
    },
    "keywords": [
        "agent",
        "chat",
        "human-in-the-loop",
        "prism",
        "prism-harness",
        "hitl",
        "sse",
        "event-sourcing",
        "human-plus",
        "fancy",
        "particle-academy"
    ],
    "devDependencies": {
        "@types/node": "^22",
        "tsup": "^8.5.0",
        "typescript": "^5.8.0",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "overrides": {
        "esbuild": "^0.28.1",
        "source-map-js": "^1.2.2"
    }
}
